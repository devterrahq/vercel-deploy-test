{
  "compilerOptions": {
    /* Basic Options */
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2022",
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "incremental": true,
    "jsx": "preserve",

    /* Strictness */
    "strict": true,
    // "noUncheckedIndexedAccess": true,

    /* Module Resolution Options */
    "moduleResolution": "Bundler",
    "module": "esnext",
    "noEmit": true,

    /* If your code runs in the DOM: */
    "lib": [
      "es2022",
      "dom",
      "dom.iterable"
    ],

    "paths": {
      "@/*": [
        "./src/*"
      ],
      "storyblok-js-client": [
        "./node_modules/storyblok-js-client/dist/types/entry.esm.d.ts"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "scripts/**/*.ts",
    ".next/types/**/*.ts",
    "*.js",
    ".*.cjs",
    "*.ts",
    "scripts/*.js"
  ],
  "exclude": [
    "node_modules",
    "src/component-types.d.ts",
    "src/components.*.json",
    "migrations"
  ]
}
