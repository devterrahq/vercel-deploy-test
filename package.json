{
  "name": "investment-and-wealth-institute",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "build-local": "npm run generate && next build --debug",
    "start": "concurrently \"npm run https\" \"next start\"",
    "lint": "next lint",
    "lint-fix": "next lint --fix",
    "dev": "concurrently \"npm run https\" \"next dev\"",
    "https": "npx local-ssl-proxy --source 3010 --target 3000 --cert localhost.pem --key localhost-key.pem",
    "generate": "npx storyblok@3 pull-components --space=1016289 --path=src/ -f storyblok && sb-gen-ts source=./src/components.storyblok.json target=./src/component-types",
    "ssl": "mkcert -install && mkcert localhost",
    "clean": "rm -rf .next",
    "storybook": "storybook dev -p 6006 --https --ssl-cert localhost.pem --ssl-key localhost-key.pem",
    "build-storybook": "npx storybook build",
    "update-external-json-to-local": "sh ./scripts/update-field-options-url.sh -l",
    "update-external-json-to-dev": "sh ./scripts/update-field-options-url.sh -d",
    "update-external-json-to-prod": "sh ./scripts/update-field-options-url.sh",
    "deep-clean": "rm -rf .next node_modules package-lock.json"
  },
